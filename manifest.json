{
  "manifest_version": 3,
  "name": "MD to Lark Docs",
  "version": "1.0.0",
  "description": "Convert Markdown to Lark Docs with diagram support",
  "permissions": ["activeTab", "tabs", "clipboardWrite", "clipboardRead", "scripting"],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.larksuite.com/*",
        "*://*.feishu.cn/*",
        "*://*.lark.suite.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup/index.html", "popup/assets/*"],
      "matches": [
        "*://*.larksuite.com/*",
        "*://*.feishu.cn/*",
        "*://*.lark.suite.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
